<Page
    x:Class="SonarGameBar.Widget.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Grid Padding="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="SONAR MIXER"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                CharacterSpacing="80"
                VerticalAlignment="Center" />

            <StackPanel
                Grid.Column="1"
                x:Name="BatteryPanel"
                Orientation="Horizontal"
                Spacing="5"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                Visibility="Collapsed">
                <FontIcon Glyph="&#xEBAA;" FontSize="13" Foreground="{StaticResource SonarAccentBrush}" />
                <TextBlock
                    x:Name="BatteryText"
                    Text="--"
                    FontSize="12"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#FFC857" />
                <TextBlock
                    x:Name="ConnectionStatusText"
                    Text="连接中"
                    FontSize="12"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <Button
                Grid.Column="3"
                x:Name="RefreshButton"
                Style="{StaticResource IconButtonStyle}"
                Click="RefreshButton_Click"
                ToolTipService.ToolTip="重新连接"
                AutomationProperties.Name="重新连接">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <Border
            Grid.Row="1"
            x:Name="NoticePanel"
            Visibility="Collapsed"
            Margin="0,0,0,8"
            Padding="8,6"
            Background="#332A2214">
            <TextBlock
                x:Name="NoticeText"
                TextWrapping="Wrap"
                FontSize="11"
                Foreground="#FFD581" />
        </Border>

        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ChannelRowsPanel" />
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="CHATMIX" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" CharacterSpacing="70" />
                <TextBlock Grid.Column="1" x:Name="ChatMixValueText" Text="居中" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
            </Grid>

            <StackPanel
                Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="6"
                Margin="0,5,0,0">
                <Button Content="游戏" Tag="-70" Style="{StaticResource QuickButtonStyle}" Click="ChatMixQuickButton_Click" ToolTipService.ToolTip="ChatMix 偏向游戏" />
                <Button Content="居中" Tag="0" Style="{StaticResource QuickButtonStyle}" Click="ChatMixQuickButton_Click" ToolTipService.ToolTip="ChatMix 居中" />
                <Button Content="聊天" Tag="70" Style="{StaticResource QuickButtonStyle}" Click="ChatMixQuickButton_Click" ToolTipService.ToolTip="ChatMix 偏向聊天" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="游戏" Style="{StaticResource ValueLabelStyle}" HorizontalAlignment="Left" />
                <Slider
                    Grid.Column="1"
                    x:Name="ChatMixSlider"
                    Minimum="-100"
                    Maximum="100"
                    StepFrequency="1"
                    Foreground="#FFC857"
                    ValueChanged="ChatMixSlider_ValueChanged"
                    AutomationProperties.Name="游戏聊天平衡" />
                <TextBlock Grid.Column="2" Text="聊天" Style="{StaticResource ValueLabelStyle}" HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Grid>
</Page>
