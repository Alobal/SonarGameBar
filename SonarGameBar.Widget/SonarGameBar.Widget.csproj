  <Target Name="PublishBridge" BeforeTargets="PrepareForBuild">
    <MSBuild
      Projects="$(BridgeProject)"
      Targets="Restore;Publish"
      BuildInParallel="false"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(BridgePublishDir)" />
    <ItemGroup>
      <_BridgeFile Include="$(BridgePublishDir)**\*" />
      <AppxPackagePayload Include="@(_BridgeFile)">
        <TargetPath>Bridge\%(_BridgeFile.RecursiveDir)%(_BridgeFile.Filename)%(_BridgeFile.Extension)</TargetPath>
      </AppxPackagePayload>
    </ItemGroup>
  </Target>

